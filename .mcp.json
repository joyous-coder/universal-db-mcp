{
  "mcpServers": {
    "universal-db-mcp": {
      "type": "stdio",
      "command": "node",
      "args": ["D:/Links/Tools/universal-db-mcp/dist/index.js"],
      "env": {
        "MODE": "mcp",
        "LOG_LEVEL": "warn",
        "DB_TYPE": "",
        "DB_HOST": "localhost",
        "DB_LAZY_LOAD_ENABLED": "false",
        "DB_ALLOWED_FILE_PATHS": "/nonexistent",
        "DB_QUERY_ANALYZER_ENABLED": "true",
        "DB_METRICS_ENABLED": "true",
        "DB_PLAN_HISTORY_DB_PATH": ".e2e-plan-history.db"
      }
    }
  }
}
